# EINSTEIN REMOTE — servidor como serviço do Linux (sem Docker). Instalação em deploy/README.md:
#   sudo cp deploy/einstein-remote.service /etc/systemd/system/ && sudo systemctl enable --now einstein-remote
# Escuta só em 127.0.0.1:8000; o HTTPS fica com o Caddy (deploy/Caddyfile.host) na mesma máquina.
[Unit]
Description=EINSTEIN REMOTE (servidor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=einstein
Group=einstein
WorkingDirectory=/opt/einstein-remote
Environment=EINSTEIN_DATA_DIR=/var/lib/einstein-remote
Environment=EINSTEIN_COOKIE_SECURE=1
# --proxy-headers: confia no X-Forwarded-For apenas vindo de 127.0.0.1 (o Caddy local)
ExecStart=/opt/einstein-remote/venv/bin/uvicorn app.main:app --app-dir /opt/einstein-remote/server --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3

# isolamento: o servidor só escreve no próprio diretório de dados
StateDirectory=einstein-remote
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
